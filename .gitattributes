# Line endings and diff/merge behaviour for the Unity base project.
#
# Without this, every developer's checkout renormalises text files to their platform's
# line endings, so a macOS/Linux teammate touching one line produces a whole-file diff.
# Everything text is stored LF in the repo and checked out natively.

* text=auto

# ---------------------------------------------------------------------------
# Source and config — always LF
# ---------------------------------------------------------------------------
*.cs            text eol=lf diff=csharp
*.shader        text eol=lf
*.shadergraph   text eol=lf
*.cginc         text eol=lf
*.hlsl          text eol=lf
*.compute       text eol=lf
*.json          text eol=lf
*.txt           text eol=lf
*.md            text eol=lf
*.xml           text eol=lf
*.jsx           text eol=lf
*.strings       text eol=lf
*.plist         text eol=lf
*.asmdef        text eol=lf
*.asmref        text eol=lf
.gitattributes  text eol=lf
.gitignore      text eol=lf

# Windows batch files break on LF — cmd.exe requires CRLF.
# Assets/StreamingAssets/config.bat depends on this.
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# ---------------------------------------------------------------------------
# Unity YAML assets
#
# These are text, but merging them by line is how scenes and prefabs get corrupted.
# `merge=unityyamlmerge` routes conflicts through Unity's SmartMerge tool.
#
# It needs a one-time setup per machine — until then git silently falls back to the
# normal merge driver, so this is safe to leave in place either way:
#
#   git config --global merge.unityyamlmerge.name "Unity SmartMerge"
#   git config --global merge.unityyamlmerge.driver \
#     '"C:/Program Files/Unity/Hub/Editor/<version>/Editor/Data/Tools/UnityYAMLMerge.exe" \
#      merge -p "$BASE" "$REMOTE" "$LOCAL" "$MERGED"'
# ---------------------------------------------------------------------------
*.unity                 text eol=lf merge=unityyamlmerge
*.prefab                text eol=lf merge=unityyamlmerge
*.asset                 text eol=lf merge=unityyamlmerge
*.meta                  text eol=lf merge=unityyamlmerge
*.mat                   text eol=lf merge=unityyamlmerge
*.anim                  text eol=lf merge=unityyamlmerge
*.controller            text eol=lf merge=unityyamlmerge
*.overrideController    text eol=lf merge=unityyamlmerge
*.physicMaterial        text eol=lf merge=unityyamlmerge
*.physicsMaterial2D     text eol=lf merge=unityyamlmerge
*.playable              text eol=lf merge=unityyamlmerge
*.mask                  text eol=lf merge=unityyamlmerge
*.rendertexture         text eol=lf merge=unityyamlmerge
*.lighting              text eol=lf merge=unityyamlmerge
*.terrainlayer          text eol=lf merge=unityyamlmerge
*.signal                text eol=lf merge=unityyamlmerge
*.brush                 text eol=lf merge=unityyamlmerge

# ---------------------------------------------------------------------------
# Binary — never normalise, never diff
# ---------------------------------------------------------------------------
# Images
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.bmp       binary
*.webp      binary
*.tga       binary
*.tif       binary
*.tiff      binary
*.psd       binary
*.exr       binary
*.hdr       binary
*.cubemap   binary

# Fonts
*.ttf       binary
*.otf       binary
*.fon       binary
*.fnt       binary

# Audio / video
*.mp3       binary
*.wav       binary
*.ogg       binary
*.aif       binary
*.aiff      binary
*.mp4       binary
*.webm      binary
*.mov       binary
*.avi       binary

# Models
*.fbx       binary
*.obj       binary
*.blend     binary
*.dae       binary
*.3ds       binary

# Managed / native libraries and Android artifacts
*.dll       binary
*.pdb       binary
*.mdb       binary
*.so        binary
*.a         binary
*.lib       binary
*.dylib     binary
*.aar       binary
*.jar       binary
*.apk       binary
*.aab       binary
*.srcaar    binary

# Archives and packages
*.zip       binary
*.7z        binary
*.gz        binary
*.rar       binary
*.unitypackage binary

# macOS native plugin bundles are directories whose payload has no file extension.
# Blanket-binary the contents, then re-assert the text files Unity and macOS keep in
# there — later rules win, so these must come after the blanket rule.
# (.strings is deliberately left binary: Apple ships those as UTF-16.)
# `binary` is a macro for `-text -diff`, so the re-assert has to restore `diff` too —
# otherwise these stay text for merge purposes but never show a textual diff.
**/*.bundle/**              binary
**/*.bundle/**/*.meta       text eol=lf diff merge=unityyamlmerge
**/*.bundle/**/*.plist      text eol=lf diff
